# URL de connexion à la base de données Supabase (format PostgreSQL)
# Disponible dans Supabase Dashboard > Settings > Database > Connection string
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# URL de ton projet Supabase (ex: https://xxxx.supabase.co)
# Utilisée pour construire l'URL JWKS : {SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_URL="https://xxxx.supabase.co"

# Port d'écoute du serveur Express (Railway injecte cette variable automatiquement)
PORT=3000

# Origines autorisées à appeler l'API depuis un navigateur (Expo web), séparées par des virgules.
# Par défaut (variable absente) : https://vocabio.vercel.app uniquement.
# En local, autoriser le serveur de dev Expo web :
CORS_ORIGINS="http://localhost:8081"

# Article sync (easy Spanish articles copied from holaquepasa.com, text + audio).
# Only the exact value "true" enables it; anything else (or no variable) leaves it off.
# Keep it off unless you are testing privately: the source's content is not licensed
# for reuse. When on, the server fetches new articles 30 s after start, then every 6 h.
ARTICLES_SYNC_ENABLED="false"
