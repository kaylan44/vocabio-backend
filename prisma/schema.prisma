// Prisma est l'ORM qui fait le lien entre notre code TypeScript et la base PostgreSQL.
// Ce fichier définit :
// - comment se connecter à la BDD (datasource)
// - comment générer le client TypeScript (generator)
// - la structure des tables (models)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // L'URL est lue depuis la variable d'environnement DATABASE_URL (définie dans .env)
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// TABLE users
// Miroir de Supabase Auth. L'id est le même UUID
// que celui émis par Supabase dans le JWT (champ "sub").
// Créé via upsert lazy dans le middleware auth.
// ─────────────────────────────────────────────
model User {
  id        String   @id               // UUID provenant de Supabase Auth
  username  String
  avatarUrl String?                    // Optionnel : photo de profil Google
  createdAt DateTime @default(now())

  // Relations : un user peut être participant à plusieurs conversations
  // et avoir envoyé plusieurs messages
  participants Participant[]
  sentMessages Message[]
  quizSessions QuizSession[]
}

// ─────────────────────────────────────────────
// TABLE conversations
// Représente un canal 1:1 entre deux utilisateurs.
// Une conversation est créée une seule fois (idempotent via getOrCreate).
// ─────────────────────────────────────────────
model Conversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  participants Participant[]
  messages     Message[]
}

// ─────────────────────────────────────────────
// TABLE participants
// Table pivot : lie un User à une Conversation.
// Pour une conv 1:1, il y a toujours exactement 2 lignes par conversation.
// La clé primaire composite (conversationId + userId) empêche les doublons.
// ─────────────────────────────────────────────
model Participant {
  conversationId String
  userId         String

  conversation Conversation @relation(fields: [conversationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  // Clé primaire composite : un user ne peut être qu'une fois dans une conversation
  @@id([conversationId, userId])
}

// ─────────────────────────────────────────────
// TABLE messages
// readAt est NULL tant que le message n'a pas été lu.
// Quand le destinataire ouvre la conversation, on fait un UPDATE en masse
// pour setter readAt sur tous les messages non lus.
// ─────────────────────────────────────────────
model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime  @default(now())
  readAt         DateTime? // NULL = non lu, rempli quand le destinataire ouvre la conv

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation(fields: [senderId], references: [id])
}

// ─────────────────────────────────────────────
// TABLE QuizSession
// One row per quiz FINISHED by a signed-in user (guests persist nothing).
//
// The id is a UUID generated by the CLIENT, not by the database: it is the
// idempotency key. If the app sends the same quiz twice (retry on a bad network,
// result screen rendered twice), the second insert hits the primary key and we
// return the existing row instead of storing a duplicate.
//
// mode is a String, not a Prisma enum: an enum value must be an identifier
// (letters, digits, "_"), so 'fr-es' would need `fr_es @map("fr-es")` plus a
// conversion in the service, and every new mode would need a migration.
// Trade-off: the database does not reject an unknown value by itself; the route
// is the only write path and validates it (see QUIZ_MODES in quizService.ts).
//
// score and total are redundant with the answers, but storing them here lets the
// common aggregates (number of quizzes, average score) run without a join.
// Both are computed by the server from the answers, never sent by the client.
// ─────────────────────────────────────────────
model QuizSession {
  id        String   @id // UUID generated by the client (idempotency key)
  userId    String
  mode      String // 'fr-es' | 'es-fr'
  score     Int // number of correct answers
  total     Int // number of questions
  createdAt DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id])
  answers QuizAnswer[]

  // First index of the project. Every statistics query filters by userId, and the
  // rate limit reads the user's most recent session (userId + createdAt DESC).
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────
// TABLE QuizAnswer
// One row per question of a quiz session.
//
// The vocabulary lives inside the mobile app (static files), the backend has no
// word table: wordId is an opaque string, and category / level are COPIED onto
// each answer. Without that copy, statistics by category or level would be
// impossible to compute here.
//
// No index on wordId: no query filters by wordId alone, they all go through
// session.userId. The unique constraint below already creates an index starting
// with sessionId, which is what that join uses.
// ─────────────────────────────────────────────
model QuizAnswer {
  id        String  @id @default(uuid())
  sessionId String
  position  Int // 0-based order of the question in the quiz
  wordId    String // opaque id from the app vocabulary, e.g. 'n001'
  category  String // 'noun' | 'verb' | ... (see QUIZ_CATEGORIES)
  level     String // 'A1' | 'A2' | ... (see QUIZ_LEVELS)
  isCorrect Boolean

  // Cascade: an answer has no meaning without its session.
  session QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // A session cannot have two answers at the same position.
  @@unique([sessionId, position])
}
